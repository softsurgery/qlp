{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "#lib/*": ["./src/lib/*"],
      "#components/*": ["./src/components/*"],
      "#hooks/*": ["./src/hooks/*"],
      "@qlp/ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
