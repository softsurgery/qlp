{
  "name": "qlp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "turbo run dev --filter=./apps/*",
    "dev:api": "turbo run dev --filter=@qlp/api",
    "dev:web": "turbo run dev --filter=@qlp/web",
    "dev:admin": "turbo run dev --filter=@qlp/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "bcrypt",
      "esbuild"
    ]
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0"
  }
}
