{
  "name": "@qlp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "cli": "node --no-experimental-strip-types -r ts-node/register -r tsconfig-paths/register src/cli.ts",
    "seed:all": "pnpm cli seed:permissions && pnpm cli seed:roles && pnpm cli seed:admin",
    "seed:playground": "pnpm cli seed:playground-users",
    "seed:permissions": "pnpm cli seed:permissions",
    "seed:roles": "pnpm cli seed:roles",
    "seed:admin": "pnpm cli seed:admin",
    "seed:playground-users": "pnpm cli seed:playground-users",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
