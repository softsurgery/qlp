# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=qlp
DATABASE_PASSWORD=qlp_dev
DATABASE_NAME=qlp

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# App
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Redis (cache, presence, LiveKit Egress job queue on App VM in production)
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage (MinIO local; managed S3-compatible in production)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=qlp_minio
STORAGE_SECRET_KEY=qlp_minio_dev
STORAGE_BUCKET=qlp-uploads
STORAGE_USE_SSL=false

# LiveKit — primary video layer (Cloud for dev; self-hosted Media VM for prototype prod)
# See docs/deployment.md and docs/architecture.md
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Admin seed
ADMIN_EMAIL=admin@qlp.local
ADMIN_PASSWORD=Admin123!
